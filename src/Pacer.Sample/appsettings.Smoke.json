{
  // Layered over appsettings.json when DOTNET_ENVIRONMENT=Smoke: a short custom-shaped run for a
  // quick check in CI or before a full test.
  "Pacer": {
    "Load": {
      "Profile": "custom",
      "Warmup": "0",
      "Stages": [
        { "StartUsers": 0, "EndUsers": 5, "Duration": "3s" },
        { "StartUsers": 5, "EndUsers": 5, "Duration": "5s" },
        { "StartUsers": 5, "EndUsers": 0, "Duration": "2s" }
      ]
    }
  }
}
