<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin the repo to nuget.org so builds don't depend on whatever feeds a developer has configured
  machine-wide. With central package management and warnings-as-errors, an extra (or unreachable)
  source otherwise fails restore with NU1507 / NU1900.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
